# Auto-generated by colima on macOS host; silently ignored elsewhere
# (ssh tolerates missing Include paths since OpenSSH 7.3+).
Include ~/.colima/ssh_config

# Default github.com → work identity.
# Catches `git@github.com:org/repo` remotes in repos that don't fall under
# an identity-specific includeIf (e.g. ad-hoc clones).
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/workgithub_id_ed25519.pub
    IdentitiesOnly yes

# Each alias pins ssh to one .pub file as a selector, so the 1Password agent
# presents only the matching private key. The personal gitconfig routes to its
# alias via url.insteadOf; the work gitconfig passes the same work .pub through
# core.sshCommand instead, keeping remote URLs plain github.com for gh-stack.
# github.com-work stays for explicit use (`ssh -T git@github.com-work`).
Host github.com-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/workgithub_id_ed25519.pub
    IdentitiesOnly yes

Host github.com-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/mitchesgotglitches_id_ed25519.pub
    IdentitiesOnly yes

# The .pub files above only select a key; the private keys live in 1Password.
# Set the agent here rather than relying on SSH_AUTH_SOCK, which apps started
# from the Dock (VS Code) do not inherit. Last, because ssh keeps the first
# value it finds for each option.
Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
