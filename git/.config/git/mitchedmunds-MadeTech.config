[user]
	email = mitchell.edmunds@madetech.com
	name = Mitch Edmunds (MadeTech)

# The work .pub is a selector: the 1Password agent presents only the matching
# private key, as the github.com-work ssh alias does. Set here rather than as
# url."git@github.com-work:".insteadOf, because insteadOf rewrites the URL every
# tool reads, and gh extensions such as gh-stack do not recognise the alias as
# a GitHub host. Remote URLs stay plain git@github.com:.
[core]
	sshCommand = ssh -i ~/.ssh/workgithub_id_ed25519.pub -o IdentitiesOnly=yes
